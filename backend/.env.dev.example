# ─────────────────────────────────────────────────────────────────────────────
# Field Ops (TIQCollect) — NATIVE development overrides
#
#   cp .env.dev.example .env.dev      then load it before running the backend:
#   set -a; . .env.dev; set +a; uvicorn ...
#
# .env holds Docker values, where hosts are compose service names. Running the
# backend on your machine instead means reaching the containers through their
# published ports on localhost. Only the lines that differ are here — read this
# alongside .env, not instead of it.
#
# Infrastructure is published on a 1xxxx block so it cannot clash with a
# Postgres, Redis or MinIO you already run:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d postgres redis minio
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://collections:CHANGE_ME@localhost:15432/fieldops
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2
MINIO_ENDPOINT=localhost:19000
# Vite dev server, not the same-origin container build.
ALLOWED_ORIGINS=http://localhost:5473
DEBUG=true
APP_ENV=development
