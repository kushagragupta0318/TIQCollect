# ─────────────────────────────────────────────────────────────────────────────
# Field Ops (TIQCollect) — service environment (Docker)
#
#   cp .env.example .env
#
# Hostnames below are compose service names. For running natively, see
# .env.dev.example. ${VAR} resolves from the platform-wide ../../.env.
#
# Shared by three containers from one image: the API, the Celery worker and
# Celery beat. The only thing that differs between them is RUN_SEED, which is
# set per container in docker-compose.yml because one file cannot hold three
# different values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=TIQCollect
APP_ENV=production
# true exposes /docs and /redoc. Keep false anywhere public.
DEBUG=false
# Signs the JWTs this app issues — anyone who knows it can forge a session.
# Generate:  openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
# Its OWN database, not a schema in `collections`: scripts/seed_data.py drops
# every enum in the public schema with CASCADE, which inside the shared
# database would take the other three apps' types with it.
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/fieldops

# ── Redis ────────────────────────────────────────────────────────────────────
# OTP store on db 0; Celery broker and results on 1 and 2.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── MinIO (photos, signatures, recordings) ───────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
MINIO_BUCKET_DOCUMENTS=tiq-documents
MINIO_SECURE=false

# Host the BROWSER uses for pre-signed upload/download URLs. The host is baked
# into the signature, so while this is blank the URLs carry the internal
# minio:9000 and a browser cannot use them — uploads reach the API but never
# the object store. Point it at a public media host to finish that path.
# Example: MINIO_PUBLIC_ENDPOINT=media.transorg.ai  with  MINIO_PUBLIC_SECURE=true
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=

# ── Command Centre contract ──────────────────────────────────────────────────
# Shared secret for /api/field-ops/*. The gate is off unless the flag is true,
# but the key has no default and the app will not start without it.
# Generate:  openssl rand -hex 32
COMMAND_CENTRE_API_KEY=
FIELD_OPS_REQUIRE_API_KEY=false

# ── Compliance ───────────────────────────────────────────────────────────────
# RBI allows collections contact 08:00-19:00 IST, enforced with a real 403.
# 0 and 24 disable the window so a demo outside Indian hours still works.
# Set 8 and 19 for true behaviour.
CONTACT_HOUR_START=0
CONTACT_HOUR_END=24
# Metres an agent must be within to record a visit.
GEO_FENCE_METRES=100

# ── Demo mode ────────────────────────────────────────────────────────────────
# true re-anchors the showcase customers to the agent's live GPS on check-in.
# Without it the geo-fence blocks every visit unless you are standing at a
# seeded Gurugram address, which makes the agent flow impossible to show.
DEMO_MODE=true
# true returns the borrower's payment OTP to the agent app. That lets an agent
# confirm a payment without the borrower, so keep it false on any deployment
# people outside the team can reach, even when DEMO_MODE is true.
DEMO_OTP_ECHO=false
DEMO_CONTACT_NAME=Balraj Singh
# A real number you can answer — the demo calls and messages it.
# Example: DEMO_CONTACT_PHONE=9876543210
DEMO_CONTACT_PHONE=
DEMO_CONTACT_REF=DEMO0003
DEMO_ANCHOR_REFS=DEMO0003,DEMO0002,DEMO0006,DEMO0007,DEMO0010
DEMO_ANCHOR_RADIUS_M=80
# Repeatable demos. The showcase case moves to Done the first time it is shown,
# leaving nothing for the next audience. true makes the agent's check-in rewind
# that one case to a stored baseline first, so the same walkthrough can be given
# over and over without reseeding. The visit itself still writes normally and is
# undone afterwards; nothing outside that case is affected.
# Needs a baseline once:  docker compose exec field-ops python -m scripts.demo_reset --save
DEMO_REHEARSAL_MODE=true

# ── Twilio ───────────────────────────────────────────────────────────────────
# Same account as Digi-Tele; values live in ../../.env.
# SMS and WhatsApp need the first four. The in-app dialler needs all seven —
# without the API-key trio it returns an error instead of a call token.
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}
TWILIO_WHATSAPP_FROM=${TWILIO_WHATSAPP_FROM}
# Console > Account > API keys & tokens > Create API key. SID starts "SK".
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Console > Voice > TwiML apps. SID starts "AP".
TWILIO_TWIML_APP_SID=

# ── AI ───────────────────────────────────────────────────────────────────────
# Visit report generation and hosted Whisper transcription.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# "openai" uses the hosted API; "local" uses faster-whisper, which is excluded
# from the image to keep the build small — add it back before switching.
TRANSCRIPTION_PROVIDER=openai
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu

# ── Razorpay (UPI payment links, test mode) ──────────────────────────────────
# Blank returns a clean "not configured" error instead of a link.
# Dashboard > Settings > API Keys. Test keys start "rzp_test_".
RAZORPAY_TEST_API=
RAZORPAY_TEST_KEY_SECRET=

# ── Routing ──────────────────────────────────────────────────────────────────
# The public demo server is rate-limited; self-host for real use.
OSRM_BASE_URL=http://router.project-osrm.org
AVG_VISIT_DURATION_MINUTES=15
GOOGLE_MAPS_API_KEY=

# ── SOS ──────────────────────────────────────────────────────────────────────
# Comma-separated numbers alerted when an agent raises an SOS.
# Example: SOS_EMERGENCY_CONTACTS=+919876543210,+919812345678
SOS_EMERGENCY_CONTACTS=

# ── Web ──────────────────────────────────────────────────────────────────────
# FastAPI serves the SPA same-origin, so this only matters for cross-origin
# callers.
# Example: https://fieldops.transorg.ai
ALLOWED_ORIGINS=https://fieldops.transorg.ai

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
