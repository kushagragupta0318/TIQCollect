# ─── CHANGELOG (prototype → product) ─────────────────────────────────────────
# 2026-07-13 — Added OSRM_BASE_URL / AVG_VISIT_DURATION_MINUTES (below, under
#   "OSRM routing") so the routing engine's map-service host and per-visit
#   service-time estimate are env-driven, not hardcoded.
# 2026-07-14 — Added TRANSCRIPTION_PROVIDER / WHISPER_MODEL_SIZE /
#   WHISPER_DEVICE (below "Transcription") — switches visit-recording
#   transcription between the hosted OpenAI Whisper API and a free
#   self-hosted faster-whisper model. Default stays "openai".
#   Full detail + why for both days: /changelog.md
# ───────────────────────────────────────────────────────────────────────────

# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=TIQCollect
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ────────────────────────────────────────────────────────────────
# Host ports are 15432/16379/19000, not the defaults — see docker-compose.yml.
#
# IMPORTANT: the POSTGRES_* values below do NOT reach docker compose. Compose
# reads the .env sitting next to docker-compose.yml (the repo root), not this
# one, so with no root .env it falls back to its own defaults and initialises
# the database named `tiqcollect`. Point DATABASE_URL at a different name and
# you get "database ... does not exist" on the first query, because nothing
# ever created it.
#
# Either keep the name below in step with DATABASE_URL, or create the database
# once:  docker exec tiqcollect_postgres createdb -U tiqcollect <name>
#
# POSTGRES_DB only takes effect on a FRESH volume — changing it later does
# nothing until you drop the volume, since Postgres only runs its init on an
# empty data directory.
DATABASE_URL=postgresql+psycopg2://tiqcollect:tiqcollect_pass@localhost:15432/tiqcollect
POSTGRES_DB=tiqcollect
POSTGRES_USER=tiqcollect
POSTGRES_PASSWORD=tiqcollect_pass

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2

# ─── MinIO (document storage) ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=tiqcollect_minio
MINIO_SECRET_KEY=tiqcollect_minio_secret
MINIO_BUCKET_DOCUMENTS=tiq-documents
MINIO_SECURE=false

# Host the BROWSER uses for pre-signed upload/download URLs. The host is baked
# into the signature, so a URL signed against an internal address (e.g.
# minio:9000 behind Docker) cannot be reached by a browser or rewritten later.
# Blank = fall back to MINIO_ENDPOINT, which is right for local dev. Set these
# to a public media host to make photo/recording upload work from anywhere.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=

# ─── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ─── OSRM routing (self-host in production, e.g. http://osrm:5000) ─────────
OSRM_BASE_URL=http://router.project-osrm.org
AVG_VISIT_DURATION_MINUTES=15

# ─── Firebase (FCM push notifications) ───────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5473,http://localhost:3000

# ─── OpenAI (AI visit reports) ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here

# ─── Transcription (visit recording -> text) ─────────────────────────────────
# "openai" = hosted Whisper API (paid, needs OPENAI_API_KEY above)
# "local"  = self-hosted faster-whisper (free, runs on this machine/GPU;
#             `pip install faster-whisper` first, see requirements.txt)
TRANSCRIPTION_PROVIDER=openai
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu

# ─── Bank Command Centre ─────────────────────────────────────────────────────
# Shared secret for the /api/field-ops/* contract surface. The gate is OFF by
# default so a local Command Centre works without configuration; turn it on for
# any deployment reachable beyond localhost, because those endpoints expose live
# agent GPS and collections figures.
COMMAND_CENTRE_API_KEY=CHANGE_ME_BANK_API_KEY
FIELD_OPS_REQUIRE_API_KEY=false

# ─── Twilio (agent voice calls, SMS/WhatsApp notifications) ──────────────────
# All optional: leave blank and the features degrade rather than crash.
#   * notification_service.py needs ACCOUNT_SID + AUTH_TOKEN to send at all,
#     and PHONE_NUMBER / WHATSAPP_FROM as the sender.
#   * the in-app agent dialler (agent.py) additionally needs API_KEY_SID,
#     API_KEY_SECRET and TWIML_APP_SID; without all four it returns an error
#     instead of a call token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Twilio's shared WhatsApp sandbox number; replace with your own sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# ─── Razorpay (payment collection, test mode) ───────────────────────────────
# Optional. Test-mode keys are still credentials — do not commit real values.
RAZORPAY_TEST_API=
RAZORPAY_TEST_KEY_SECRET=

# ─── Contact Hour Enforcement (RBI) ─────────────────────────────────────────
# The window collections contact is legally allowed. geo.py reads these, so a
# demo in a non-IST timezone can widen/shift the window via .env, no code change.
CONTACT_HOUR_START=8
CONTACT_HOUR_END=19

# ─── Geo-fence ──────────────────────────────────────────────────────────────
# Metres an agent must be within to record a visit (moved out of geo.py).
GEO_FENCE_METRES=100

# ─── Demo / Showcase ────────────────────────────────────────────────────────
# Leave false in real deployments. When true:
#  (1) the DEMO_ANCHOR_REFS customers are re-placed within DEMO_ANCHOR_RADIUS_M
#      of the agent's LIVE GPS on every check-in, so the geo-fence passes
#      wherever on earth the demo is run;
#  (2) DEMO_CONTACT_REF's name/phone are synced from the vars below on startup,
#      so the showcase number is a .env edit + restart — no reseed.
#
# DEMO_CONTACT_REF is ALWAYS anchored and always lands closest to the agent,
# whether or not you list it in DEMO_ANCHOR_REFS — the showcase customer has to
# be callable in range for the demo to work, so it is not left to a .env edit.
DEMO_MODE=false
DEMO_CONTACT_NAME=Balraj Singh
DEMO_CONTACT_PHONE=8015935790
DEMO_CONTACT_REF=DEMO0003
DEMO_ANCHOR_REFS=DEMO0003,DEMO0002,DEMO0006,DEMO0007,DEMO0010
DEMO_ANCHOR_RADIUS_M=80

# ─── SOS Alerts ──────────────────────────────────────────────────────────────
SOS_EMERGENCY_CONTACTS=+91XXXXXXXXXX,+91YYYYYYYYYY

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
