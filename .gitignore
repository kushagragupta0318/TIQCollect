# TIQCollect — ignore rules.
#
# 2026-08-17: this file used to say the platform-wide basics (.env, .venv/,
# node_modules/, __pycache__/, dist/) "are already covered by ../.gitignore".
# That was true while this lived inside the Collections monorepo as
# field-ops-stub/. It is now a standalone repo, so ../.gitignore is gone and
# nothing was ignoring any of them — backend/.env, holding live Postgres/MinIO/
# Twilio credentials, was showing up as a stageable untracked file. Those rules
# are therefore inlined below.

# ── Env / secrets (NEVER commit real keys) ──────────────────────────────────
# Anything ending .env at any depth is local-only; only .example templates ship.
.env
.env.*
**/*.env
firebase-credentials.json
*.pem
*.key
*.p12
*.pfx

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# ── Python tooling caches ───────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Node ────────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── Data & uploads ──────────────────────────────────────────────────────────
backend/data/incoming/

# ── Logs / temp ─────────────────────────────────────────────────────────────
*.log
logs/
tmp/

# ── Docker ──────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Re-includes ─────────────────────────────────────────────────────────────
# Negations must come AFTER the rules they override — gitignore takes the last
# matching rule, so these would be dead if they sat above the .env block.
!*.example
!**/*.example

# Postgres dumps taken before/after a destructive reseed. Binary, large,
# and regenerable from scripts/seed_data.py — never in git.
backups/
