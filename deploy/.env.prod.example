# Production settings for docker-compose.prod.yml (docs/DEPLOY.md).
#   cp deploy/.env.prod.example deploy/.env.prod     # gitignored; never commit it
# Compose reads this file twice: to fill ${...} in docker-compose.prod.yml
# (--env-file) and as the containers' environment (env_file). Values the compose
# file sets itself (DATABASE_URL, REDIS_URL, MinIO endpoints, ALLOWED_ORIGINS,
# PUBLIC_BASE_URL, FORWARDED_ALLOW_IPS) are not repeated here.
#
# REQUIRED: the stack refuses to start without these.

# The release to run: an image tag built from a git tag (docs/DEPLOY.md, Release).
TIQ_VERSION=

# Public names. Both must resolve to this host before the first start (TLS).
APP_DOMAIN=                      # e.g. collect.example.in
FILES_DOMAIN=                    # e.g. files.collect.example.in (visit photos, recordings)
ACME_EMAIL=                      # Let's Encrypt account and expiry notices
# TLS issuer. Empty = public Let's Encrypt (needs both names to resolve here from
# the internet). Set to "tls internal" for a local prod server with no public DNS,
# and trust Caddy's root once: docs/LOCAL-PROD.md.
TIQ_TLS_DIRECTIVE=

# JWT signing key: 64 random characters (the API refuses under 32 in production).
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it signs everyone out.
SECRET_KEY=

POSTGRES_USER=tiq
POSTGRES_DB=tiq
POSTGRES_PASSWORD=               # 32+ random characters
MINIO_ROOT_USER=tiq-media
# The object-store image: the compose default is a pinned digest on our own ghcr
# mirror, verified byte-identical to upstream (ADR 0012). Leave MINIO_IMAGE unset
# to use it. While the mirror package is private, the host needs
# `docker login ghcr.io` once; that requirement goes away when it is public.
MINIO_ROOT_PASSWORD=             # 32+ random characters

# Fernet key for TOTP secrets. Unset: MFA enrolment is refused.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it makes every enrolled user enrol again.
TOTP_ENC_KEY=

# ── Choices ────────────────────────────────────────────────────────────────────
# "true" makes TOTP mandatory for bank users; the API then refuses to start without TOTP_ENC_KEY.
BANK_MFA_REQUIRED=
# uvicorn workers. More than 1 is safe: rate limits count in Redis.
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2
# Map tiles. Public Mapbox token (pk.*, never sk.*). Empty: OpenStreetMap tiles.
# Restrict the token to APP_DOMAIN in the Mapbox account; the app's host check is not a control.
VITE_MAPBOX_TOKEN=
# VITE_ALLOWED_MAP_HOSTS=   # defaults to APP_DOMAIN
# Road routing: a self-hosted OSRM, e.g. http://osrm:5000. Empty = straight-line
# estimates. Never the public demo server (it would receive borrower locations).
OSRM_BASE_URL=
# RBI contact window, local hours.
CONTACT_HOUR_START=8
CONTACT_HOUR_END=19
LOCATION_RETENTION_DAYS=90

# LLM (visit strategy, reports, voice-note extraction). "none" switches it off;
# every caller then labels its rule-based fallback.
LLM_PROVIDER=none
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                  # also hosted Whisper transcription
TRANSCRIPTION_PROVIDER=openai

# Payments: the lender's collection VPA for the UPI QR. Empty = no QR; the agent
# records the 12-digit UTR by hand.
UPI_VPA=
UPI_PAYEE_NAME=
BORROWER_HELPLINE=

# SMS/WhatsApp and in-app calling. Leave EMPTY until an SMS provider with DLT
# registration is in place (docs/DEPLOY.md, State today). Empty = no messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=            # its Voice URL: https://<APP_DOMAIN>/api/v1/agent/voice/outbound

# ── Demo only. Leave ALL of these unset on a deployment real people use. ──────────
# DEMO_MODE=
# DEMO_OTP_ECHO=                 # hands the borrower's payment OTP to the agent
# DEMO_DEVICE_REBIND=            # switches device binding off
# DEMO_UPI_ACCEPT=
# DEMO_MASTER_PASSWORD=
# DEMO_MASTER_ACCOUNTS=
# DEMO_MASTER_DISABLE_OTHERS=
# DEMO_NOTIFY_ALLOWLIST=
# SEED_FROM_FIXTURE=true         # a DEMO host: restore the invented demo book on first start
