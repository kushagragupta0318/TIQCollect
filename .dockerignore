# Build context hygiene — keep secrets, virtualenvs and node_modules out of the
# image. node_modules especially: the frontend stage runs its own npm ci, and a
# host-built tree can carry platform-specific binaries.
__pycache__/
*.pyc
*.pyo
.venv/
venv/
# **/ so these match at ANY depth. A bare ".env" is matched against the path
# from the context root, so it excludes only a root-level .env and happily
# copies backend/.env into the image — baking in secrets, and worse, making the
# image work on a machine that has one and fail on a machine that does not.
**/.env
**/.env.*
!**/.env.example
node_modules/
frontend/node_modules/
frontend/dist/
backend/static/
certs/
data/incoming/
.pytest_cache/
*.log

# Not needed at run time, so not shipped (RESTRUCTURE-PLAN 1.7, D6).
# Tests run from the source tree, never inside the prod image.
backend/tests/
# Unread CSV copy of the demo dump; fieldops-demo.dump itself IS needed.
backend/fixtures/tables/
# The v1 book: input to scripts/migrate_v1_to_v2 only. The v2 entrypoint refuses it.
backend/fixtures/fieldops-demo.dump
backend/docs/
# Model artifacts: serving loads only the pipeline and calibrator (*.joblib),
# metadata.json and the champion pointer. The development evidence (EDA plots,
# evaluation tables, reports) stays in git and out of the image.
backend/app/ml/artifacts/**
!backend/app/ml/artifacts/**/*.joblib
!backend/app/ml/artifacts/**/metadata.json
!backend/app/ml/artifacts/**/champion.txt
