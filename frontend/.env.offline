# Loaded only by `vite build --mode offline` (never by dev or a normal build).
# Produces a static, backend-free bundle that replays public/offline/snapshots.json
# through src/api/offlineAdapter.ts, and routes on the hash so it can be hosted
# from any sub-path. The Collections Command Center embeds this build for its
# Field Recovery → agency → analytics hand-off.
VITE_OFFLINE_SNAPSHOTS=1
